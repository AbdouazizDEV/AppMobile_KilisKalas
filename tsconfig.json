{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "src/*"
      ],
      "@/components/*": [
        "src/presentation/components/*"
      ],
      "@/hooks/*": [
        "src/presentation/hooks/*"
      ],
      "@/stores/*": [
        "src/presentation/stores/*"
      ],
      "@/core/*": [
        "src/core/*"
      ],
      "@/data/*": [
        "src/data/*"
      ],
      "@/utils/*": [
        "src/shared/utils/*"
      ],
      "@/constants/*": [
        "src/shared/constants/*"
      ],
      "@/types/*": [
        "src/shared/types/*"
      ],
      "@/config/*": [
        "src/infrastructure/config/*"
      ],
      "@/services/*": [
        "src/infrastructure/services/*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "nativewind-env.d.ts"
  ]
}
